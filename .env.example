# ─────────────────────────────────────────────────────────────
# AI STARTER TEMPLATE — Environment Variables
# ─────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file and rename it to .env.local
#   2. Fill in your real API keys
#   3. NEVER commit .env.local to Git — it is already in .gitignore
# ─────────────────────────────────────────────────────────────

# ─── Which AI provider to use ────────────────────────────────
# Options: "anthropic" | "openai" | "gemini"
# Change this one value to switch providers
AI_PROVIDER=anthropic

# ─── API Keys (only fill in the one you are using) ───────────

# Anthropic (Claude) — get your key at console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily (live web search) — get a free key at tavily.com
# Optional: without it, reports fall back to model knowledge only
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI (GPT-4, etc.) — get your key at platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini — get your key at aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ─── App Mode (cost control) ─────────────────────────────────
# Controls how much each report costs to generate:
#   mock  — NO AI call; returns a static sample report (free).
#           Use for UI work, formatting, exporting, app flow.
#   cheap — real AI on the cheapest model, 1 search, short report.
#           Use to test real AI behavior at a fraction of the cost.
#   full  — the complete agentic workflow (most expensive).
#           Use for final tests and portfolio-quality reports.
#
# SAFETY: production NEVER silently defaults to "full".
# When APP_MODE is missing or invalid:
#   - local dev  → mock  (no API calls, no accidental spend)
#   - production → cheap (safe fallback; real AI but low cost)
# To use full mode in production you MUST set APP_MODE=full
# explicitly in the Vercel dashboard.
APP_MODE=mock

# ─── Local CLI Provider (staged workflow, local development only) ────────────
# These variables control the local-cli provider used by the staged workflow.
# The local-cli provider uses your Claude Code subscription (OAuth session),
# NOT the paid ANTHROPIC_API_KEY. It avoids metered API billing entirely.
#
# To run Stage 01 with local Claude: npm run workflow:local -- --case <id>
#
# IMPORTANT LIMITATIONS:
#   - Local development only. Never used in production.
#   - Requires `claude` CLI installed and authenticated (`claude auth login`).
#   - Consumes your Claude subscription allowance, not metered API credits.
#   - One Stage 01 run = one CLI invocation + several web searches internally.
#   - Token counts are not exposed by the CLI in text mode (logged as not_available).
#
# Model: any alias supported by the CLI ("sonnet", "opus", "haiku")
# or a full model ID (e.g. "claude-sonnet-4-6").
LOCAL_CLAUDE_MODEL=sonnet

# Timeout in milliseconds for the subprocess. Stage 01 web research typically
# takes 30–120 seconds. Increase if you see ETIMEDOUT errors.
LOCAL_CLAUDE_TIMEOUT_MS=180000

# ─── App Settings ────────────────────────────────────────────
# The name shown in the browser tab and UI
NEXT_PUBLIC_APP_NAME=My AI App
