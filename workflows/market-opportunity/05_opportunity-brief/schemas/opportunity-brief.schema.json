{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-opportunity/opportunity-brief",
  "title": "Opportunity Brief",
  "description": "A decision-ready brief that separates verified facts from interpretation. Stage 05 output. Review Gate 2.",
  "type": "object",
  "required": ["candidateId", "title", "whyItMatters", "supportingEvidenceIds", "factVsInterpretation", "uncertainties", "recommendedNextAction", "humanVerificationRequired", "metadata"],
  "properties": {
    "candidateId": { "type": "string" },
    "title": { "type": "string" },
    "whyItMatters": { "type": "string" },
    "supportingEvidenceIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "evidenceIds from the validated list in 03-validation.json."
    },
    "factVsInterpretation": {
      "type": "object",
      "required": ["verifiedFacts", "modelInterpretations"],
      "properties": {
        "verifiedFacts": { "type": "array", "items": { "type": "string" }, "description": "Each must be backed by a validated evidence item." },
        "modelInterpretations": { "type": "array", "items": { "type": "string" }, "description": "Reasoning, not fact." }
      }
    },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "recommendedNextAction": { "type": "string", "description": "A research or marketing action only. Never outreach/contact." },
    "humanVerificationRequired": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "There is always at least one thing a human must confirm."
    },
    "metadata": {
      "type": "object",
      "required": ["runId", "stage", "createdAt"],
      "properties": {
        "runId": { "type": "string" },
        "stage": { "type": "string", "enum": ["opportunity-brief"] },
        "createdAt": { "type": "string" }
      }
    }
  }
}
