{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-opportunity/opportunity-score",
  "title": "Opportunity Score",
  "description": "An explainable score for one candidate against the five ICP dimensions in references/scoring-rubric.md. Stage 04 output.",
  "type": "object",
  "required": ["candidateId", "dimensions", "totalScore", "rationale", "metadata"],
  "properties": {
    "candidateId": { "type": "string" },
    "dimensions": {
      "type": "object",
      "required": ["utilitySize", "nrwEvidence", "regionFit", "targetRolePresence", "momentumSignal"],
      "properties": {
        "utilitySize": { "$comment": "see scoredDimension shape", "type": "object", "required": ["score", "justification"], "properties": { "score": { "type": "integer", "minimum": 0, "maximum": 5 }, "justification": { "type": "string" } } },
        "nrwEvidence": { "type": "object", "required": ["score", "justification"], "properties": { "score": { "type": "integer", "minimum": 0, "maximum": 5 }, "justification": { "type": "string" } } },
        "regionFit": { "type": "object", "required": ["score", "justification"], "properties": { "score": { "type": "integer", "minimum": 0, "maximum": 5 }, "justification": { "type": "string" } } },
        "targetRolePresence": { "type": "object", "required": ["score", "justification"], "properties": { "score": { "type": "integer", "minimum": 0, "maximum": 5 }, "justification": { "type": "string" } } },
        "momentumSignal": { "$comment": "bonus dimension — a low score here is expected and not a red flag on its own", "type": "object", "required": ["score", "justification"], "properties": { "score": { "type": "integer", "minimum": 0, "maximum": 5 }, "justification": { "type": "string" } } }
      }
    },
    "totalScore": { "type": "integer", "minimum": 0, "maximum": 25, "description": "Sum of the five dimension scores. Verified by the orchestrator." },
    "rationale": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["runId", "stage", "createdAt"],
      "properties": {
        "runId": { "type": "string" },
        "stage": { "type": "string", "enum": ["opportunity-scoring"] },
        "createdAt": { "type": "string" }
      }
    }
  }
}
