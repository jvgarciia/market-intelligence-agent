# ─── Dependencies ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment variables (NEVER commit these) ─────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Next.js build output ───────────────────────────────────
.next/
out/

# ─── Vercel ─────────────────────────────────────────────────
.vercel

# ─── OS files ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ───────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Build output ───────────────────────────────────────────
dist/
build/

# ─── Workflow run artifacts (keep the folder + its README only) ──
/runs/*
!/runs/README.md

# ─── Evaluation results (keep folder + .gitkeep only) ────────
/evals/results/*
!/evals/results/.gitkeep

# ─── Word lock/temp files ───────────────────────────────────
~$*.docx

# ─── Claude Code ────────────────────────────────────────────
.claude/settings.local.json
.claude/worktrees/

# ─── Editor ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
